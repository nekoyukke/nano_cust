{
  "name": "nano-cust",
  "displayName": "nano_cust",
  "description": "Syntax highlighting and editor support for nano_cust source files.",
  "version": "0.4.1",
  "main": "./extension.js",
  "publisher": "nano-cust",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:nano-cust"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nanoCust.checkSyntax",
        "title": "nano_cust: 構文・型をチェック"
      }
    ],
    "configuration": {
      "title": "nano_cust",
      "properties": {
        "nanoCust.checkOnChange": {
          "type": "boolean",
          "default": true,
          "description": "編集中の .nc ファイルを自動的にチェックします。"
        },
        "nanoCust.checkDelay": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "入力後に自動チェックを始めるまでの待機時間（ミリ秒）。"
        },
        "nanoCust.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "nano_cust のコンパイルに使用する Python 実行ファイル。"
        },
        "nanoCust.compilerPath": {
          "type": "string",
          "default": "",
          "description": "main.py のパス。空欄の場合、ワークスペース直下の main.py を使用します。"
        }
      }
    },
    "languages": [
      {
        "id": "nano-cust",
        "aliases": [
          "nano_cust",
          "Nano Cust"
        ],
        "extensions": [
          ".nc"
        ],
        "firstLine": "^\\s*(class|sprite)\\s+[A-Za-z_]",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nano-cust",
        "scopeName": "source.nano-cust",
        "path": "./syntaxes/nano-cust.tmLanguage.json"
      }
    ]
  }
}
